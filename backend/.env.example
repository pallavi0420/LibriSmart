APP_NAME="LibriSmart API"
ENVIRONMENT="development"
DEBUG=true

# Security (JWT secrets)
SECRET_KEY="librismart_super_secret_development_key_2026_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URL:
# For instant local development without installing PostgreSQL:
DATABASE_URL="sqlite+aiosqlite:///./librismart.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/librismart"

# CORS Configuration
CORS_ORIGINS=["*"]

# Library Business Rules Default Values
DEFAULT_MAX_BORROW_LIMIT=3
DEFAULT_LOAN_DURATION_DAYS=14
DEFAULT_FINE_PER_DAY_CENTS=50
DEFAULT_GRACE_PERIOD_MINUTES=15
