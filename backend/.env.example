APP_NAME="LibriSmart API"
ENVIRONMENT="production"
DEBUG=false

# REQUIRED — Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-strong-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# REQUIRED — PostgreSQL connection string from Render (or any cloud database)
DATABASE_URL="postgresql+asyncpg://user:password@host:5432/dbname"

# CORS — set to your app's domain or * for open access
CORS_ORIGINS=["*"]

# Library Business Rules
DEFAULT_MAX_BORROW_LIMIT=3
DEFAULT_LOAN_DURATION_DAYS=14
DEFAULT_FINE_PER_DAY_CENTS=50
DEFAULT_GRACE_PERIOD_MINUTES=15
